# ============================================================
# .env.example — Portofolio (Laravel 11) Docker Deployment
# ============================================================
# CARA PAKAI:
#   1. cp .env.example .env
#   2. Isi nilai di bawah (terutama APP_URL, APP_PORT, DB_*)
#   3. docker compose up -d
# ============================================================

# ----- Aplikasi -----
APP_NAME=Portofolio
APP_ENV=production              # production / staging / local
APP_KEY=                        # KOSONGKAN -> otomatis di-generate di container
APP_DEBUG=false                 # true hanya saat debugging (jangan di prod!)
APP_URL=https://domain-anda.com # Base URL publik (tanpa trailing slash)
APP_PORT=80                     # Port HOST yang memetakan ke app container
                                #   contoh: 80    -> http://domain-anda.com
                                #           8080  -> http://ip-server:8080
APP_TIMEZONE=Asia/Jakarta

# ----- Log -----
LOG_CHANNEL=stack
LOG_LEVEL=error

# ----- Database (MySQL eksternal / shared) -----
# Sesuaikan dengan host database server kamu
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_portofolio
DB_USERNAME=root
DB_PASSWORD=

# ----- Seeding -----
# true  = jalankan php artisan db:seed saat start (butuh hak tulis di DB)
# false = hanya migrate (dianjurkan untuk DB bersama/prod)
DB_SEED=false

# ----- Driver internal (aman untuk 1 server) -----
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# ============================================================
# Catatan:
#  - Aplikasi hanya menulis 1 tabel untuk form kontak (messages).
#    `php artisan migrate` akan membuat tabel `messages` (plus tabel
#    bawaan Laravel) di database yang ditunjuk DB_DATABASE.
#  - Semua konten porto (proyek/blog/layanan) berasal dari config,
#    TIDAK butuh DB.
#  - Nginx/reverse-proxy di luar Docker: arahkan ke port APP_PORT.
# ============================================================